# Little Royals — single-school API
# Do not put login passwords here. Admin password is written to .admin-credentials on first seed.

APP_ENV=development
APP_NAME=Little Royals School API
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_DRIVER=sqlite
DB_DSN=file:school.db?cache=shared&_fk=1

# Docker Compose Postgres (required when using docker compose)
POSTGRES_USER=school
POSTGRES_PASSWORD=
POSTGRES_DB=little_royals

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=24

SCHOOL_NAME=Little Royals Kindergarten and Primary School
SCHOOL_CODE=LRKPS
SCHOOL_COUNTRY=Uganda
