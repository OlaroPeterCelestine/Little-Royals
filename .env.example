# Little Royals — frontend (Vite)
VITE_USE_API=true
# Absolute API (local Go on :18080) — recommended for npm run dev
VITE_API_BASE_URL=http://127.0.0.1:18080
VITE_WS_URL=ws://127.0.0.1:18080
VITE_APP_NAME=Little Royals Desk
VITE_APP_ENV=development

# Or same-origin (Vite proxies /api + /health + WS to :18080; Docker nginx does this in prod):
# VITE_API_BASE_URL=same-origin
# VITE_WS_URL=same-origin

# Offline-only desk (no Go API):
# VITE_USE_API=false
