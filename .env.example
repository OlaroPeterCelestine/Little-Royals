# Little Royals — frontend (Vite)
VITE_USE_API=true
VITE_API_BASE_URL=http://127.0.0.1:18080
VITE_WS_URL=ws://127.0.0.1:18080
VITE_APP_NAME=Little Royals Desk
VITE_APP_ENV=development

# Offline-only desk (no Go API):
# VITE_USE_API=false

# Video (Talk) — free Google STUN is used by default.
# Optional TURN (e.g. coturn from docker compose --profile turn):
# VITE_TURN_URL=turn:127.0.0.1:3478
# VITE_TURN_USER=school
# VITE_TURN_CRED=changeme
# Optional PeerJS server (self-hosted):
# VITE_PEER_HOST=
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true
