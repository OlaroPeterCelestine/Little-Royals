# Little Royals — frontend (Vite)
# Offline by default. Leave VITE_USE_API=false until you intentionally wire the API.

VITE_USE_API=false
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_DEMO_PASSWORD=demo
VITE_APP_NAME=Little Royals Desk
VITE_APP_ENV=development

# When ready to connect the Go API:
# VITE_USE_API=true
# VITE_API_BASE_URL=http://127.0.0.1:18080
# VITE_WS_URL=ws://127.0.0.1:18080
