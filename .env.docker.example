# Little Royals — VPS Docker Compose
#   cp .env.docker.example .env.docker
#   cp backend/.env.example backend/.env
#   ./scripts/deploy-vps.sh

SCHOOL_DB_PASSWORD=change-me-school-db
APP_ENV=production

# Public desk origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=http://YOUR_VPS_IP:8080,https://desk.example.com

# same-origin = browser uses /api via nginx (recommended on one VPS)
VITE_API_BASE_URL=same-origin
VITE_WS_URL=same-origin
VITE_APP_NAME=Little Royals Desk

WEB_HTTP_PORT=8080
API_HTTP_PORT=18080

# Cloudflare R2 for uploads (optional — leave blank to use local FILES_DIR)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=little-royals-files
# R2_ENDPOINT=
